{
  "name": "symphysis-vscode",
  "displayName": "Symphysis",
  "description": "Журнал решений symphysis в VS Code: развилки, слово человека, внесение в журнал",
  "publisher": "symphysis",
  "version": "0.2.0",
  "private": true,
  "engines": { "vscode": "^1.100.0" },
  "categories": ["Other"],
  "main": "./out/extension.js",
  "capabilities": {
    "untrustedWorkspaces": { "supported": false, "description": "Расширение запускает .symphysis/tools/journal.py из проекта." },
    "virtualWorkspaces": { "supported": false, "description": "Журнал читает Python с локального диска." }
  },
  "activationEvents": ["workspaceContains:openspec/changes/*/decisions.json", "onWebviewPanel:symphysis.viewer", "onWebviewPanel:symphysis.scheme"],
  "contributes": {
    "commands": [
      { "command": "symphysis.refresh", "title": "Обновить", "category": "Symphysis", "icon": "$(refresh)" },
      { "command": "symphysis.openChange", "title": "Открыть журнал", "category": "Symphysis" },
      { "command": "symphysis.openScheme", "title": "Показать схему решения", "category": "Symphysis" },
      { "command": "symphysis.revealRecord", "title": "Показать запись", "category": "Symphysis" },
      { "command": "symphysis.revealAttack", "title": "Показать в атаке", "category": "Symphysis" }
    ],
    "viewsContainers": {
      "activitybar": [{ "id": "symphysis", "title": "Symphysis", "icon": "media/icon.svg" }]
    },
    "views": {
      "symphysis": [
        { "id": "symphysis.changes", "name": "Изменения", "initialSize": 1 },
        { "id": "symphysis.search", "name": "Поиск", "type": "webview", "initialSize": 2 },
        { "id": "symphysis.toc", "name": "Оглавление журнала", "initialSize": 2 },
        { "id": "symphysis.attackToc", "name": "Оглавление атаки", "visibility": "collapsed", "initialSize": 2 }
      ]
    },
    "viewsWelcome": [
      { "view": "symphysis.changes", "contents": "В рабочей области нет каталога openspec/changes." }
    ],
    "menus": {
      "view/title": [{ "command": "symphysis.refresh", "when": "view == symphysis.changes", "group": "navigation" }],
      "commandPalette": [
        { "command": "symphysis.openChange", "when": "false" },
        { "command": "symphysis.revealRecord", "when": "false" },
        { "command": "symphysis.revealAttack", "when": "false" }
      ]
    },
    "configuration": {
      "title": "Symphysis",
      "properties": {
        "symphysis.python": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Абсолютный путь к интерпретатору Python. Пусто — `python`, затем `python3` из PATH, каталоги рабочей области исключены. Настройка только на уровне машины: файл настроек проекта не может подменить интерпретатор."
        },
        "symphysis.hook.enabled": {
          "type": "boolean",
          "default": true,
          "scope": "resource",
          "markdownDescription": "Хук клиента: сообщает агенту о решениях, внесённых кнопкой, и о правке `scheme.md`. Плагин ставит его сам там, где есть журнал, инструменты и след клиента. Выключено: плагин снимает свою запись в `.claude/settings.local.json`, файл `.opencode/plugins/symphysis-hook.js`, скрипт и свои строки в `.git/info/exclude` и больше их не ставит."
        },
        "symphysis.colors.signal": {
          "type": "string",
          "format": "color-hex",
          "default": "#FF5555",
          "description": "Сигнальный цвет: надо реагировать — цитаты нет дословно, отказ apply, журнал изменён после показа."
        },
        "symphysis.colors.accent": {
          "type": "string",
          "format": "color-hex",
          "default": "#FFB86C",
          "description": "Выделяющийся цвет: важно заметить — открытая развилка, отступление от постановки, неснятая предпосылка, изменённый выбор."
        },
        "symphysis.colors.muted": {
          "type": "string",
          "format": "color-hex",
          "default": "#6272A4",
          "description": "Побочный цвет: показать и не отвлекать — «сверено», «не проверить», справка, служебные метки."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "node build.mjs",
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node build.mjs --unit && node --test \"out/test/*.test.js\"",
    "e2e": "node build.mjs --tests && node test/e2e/run.mjs",
    "package": "node package.mjs",
    "e2e:vsix": "node build.mjs --tests && node test/e2e/vsix.mjs",
    "e2e:reload": "node build.mjs --tests && node test/e2e/reload.mjs",
    "e2e:activation": "node build.mjs --tests && node test/e2e/activation.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/vscode": "1.100.0",
    "@vscode/test-electron": "3.1.0",
    "@vscode/vsce": "4.0.0",
    "esbuild": "0.28.2",
    "mermaid": "12.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "7.0.2"
  }
}
